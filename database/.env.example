# Supabase - Connection pooler
# Dashboard: Project Settings > Connect > Session pooler

SUPABASE_POOLER_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_POOLER_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.TU_PROJECT_REF
SUPABASE_DB_PASSWORD=tu_password_aqui

# JDBC Spring Boot (Session pooler)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.TU_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=tu_password_aqui

# Transaction pooler (puerto 6543)
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
